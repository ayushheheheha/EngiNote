.vercel
.env*

# iPad app: made on the build machine, never committed
ios/web/
ios/EngiNote.xcodeproj/
ios/App/Info.plist
ios/build/
ios/Payload/
*.ipa

# Agent worktrees
.claude/

# Android app: made on the build machine, never committed
android/app/src/main/assets/
android/app/src/main/res/mipmap-xxxhdpi/
android/.gradle/
android/build/
android/app/build/
*.apk
*.jks

# Recorder app: made on the build machine, never committed
recorder/EngiNoteRecorder.xcodeproj/
recorder/App/Info.plist
recorder/App/Recorder.entitlements
recorder/Broadcast/Info.plist
recorder/Broadcast/Broadcast.entitlements
recorder/build/
recorder/Payload/
